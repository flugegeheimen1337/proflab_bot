# Copy to .env and fill in. Never commit .env.
# If this token was pasted into a chat, revoke it in @BotFather and put the new one here.

BOT_TOKEN=
BOT_USERNAME=
DATABASE_URL=postgresql+asyncpg://anon:change-me@postgres:5432/anonchat
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=
DEFAULT_GROUP_ID=
TIMEZONE=Europe/Moscow
EPHEMERAL_MODE_ENABLED=false
INTERCEPT_MODE_ENABLED=false
REVEAL_TELEGRAM_IDS=false
LOG_LEVEL=INFO
CALLBACK_SECRET=replace-with-python-secrets-token-urlsafe-32
ADMIN_API_TOKEN=
POSTGRES_USER=anon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=anonchat
